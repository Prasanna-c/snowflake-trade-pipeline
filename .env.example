# =============================================================================
# Copy to .env and fill in. NEVER commit .env.
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Snowflake connection (shared by ingestion, dbt, Terraform, Streamlit, Airflow)
# -----------------------------------------------------------------------------
# Account identifier, e.g. ab12345.eu-central-1  (NOT the full URL)
SNOWFLAKE_ACCOUNT=ab12345.eu-central-1
# Service user and functional role, both created by Terraform. Confirm the exact
# names with `terraform output` -- they are SVC_/FR_ prefixed and env-suffixed.
SNOWFLAKE_USER=SVC_TRADES_DBT_DEV
SNOWFLAKE_ROLE=FR_TRADES_TRANSFORM_DEV

# Warehouses (created by Terraform)
SNOWFLAKE_WAREHOUSE=WH_TRADES_TRANSFORM_DEV
SNOWFLAKE_LOAD_WAREHOUSE=WH_TRADES_LOAD_DEV

# Target database / environment
SNOWFLAKE_DATABASE=TRADES_DEV
SNOWFLAKE_ENV=dev

# -----------------------------------------------------------------------------
# Authentication: key-pair is REQUIRED for automation (see docs/adr/0006-*.md).
# Generate with: make keypair
# -----------------------------------------------------------------------------
SNOWFLAKE_PRIVATE_KEY_PATH=/absolute/path/to/rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Password auth is only for the initial human bootstrap in the Snowsight UI.
# Leave blank for all service accounts.
SNOWFLAKE_PASSWORD=

# -----------------------------------------------------------------------------
# Terraform (uses an ACCOUNTADMIN-derived role, separate from the dbt user)
# -----------------------------------------------------------------------------
TF_VAR_snowflake_account=ab12345.eu-central-1
TF_VAR_snowflake_user=TRADES_SVC_TERRAFORM
TF_VAR_snowflake_role=TRADES_TERRAFORM
TF_VAR_snowflake_private_key_path=/absolute/path/to/tf_rsa_key.p8
TF_VAR_alert_email=you@example.com

# -----------------------------------------------------------------------------
# Trade simulator
# -----------------------------------------------------------------------------
# Deterministic runs for reproducible demos / tests
TRADE_SIM_SEED=42
TRADE_SIM_OUTPUT_DIR=./data/landing
# Share of records deliberately corrupted so the reject path is exercised
TRADE_SIM_ERROR_RATE=0.08
# Share of records that are amendments to previously emitted trades
TRADE_SIM_AMEND_RATE=0.20

# -----------------------------------------------------------------------------
# Airflow
# -----------------------------------------------------------------------------
# The uid the Airflow containers run as. On Linux and WSL this must be YOUR uid -- run `id -u`,
# almost always 1000 -- because docker-compose.yml mounts ../dbt, ../data and ../scripts into the
# containers. A container writing there under any other uid leaves files the host user cannot
# delete, and the first symptom is obscure: `dbt deps` fails with "Permission denied:
# 'docker-compose.yml'" while clearing dbt_packages, because unlinking a file needs write
# permission on its directory rather than on the file. Docker Desktop on macOS maps ownership
# for you, so the value does not matter there.
AIRFLOW_UID=1000
AIRFLOW_PROJ_DIR=./airflow
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# SMTP for pipeline-failure email alerts (Gmail: use an App Password)
AIRFLOW__SMTP__SMTP_HOST=smtp.gmail.com
AIRFLOW__SMTP__SMTP_PORT=587
AIRFLOW__SMTP__SMTP_STARTTLS=True
AIRFLOW__SMTP__SMTP_SSL=False
AIRFLOW__SMTP__SMTP_USER=you@gmail.com
AIRFLOW__SMTP__SMTP_PASSWORD=your_app_password
AIRFLOW__SMTP__SMTP_MAIL_FROM=you@gmail.com
ALERT_EMAIL=you@example.com

# Optional Slack incoming webhook for alerts (leave blank to disable)
SLACK_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Data quality gate thresholds (enforced by the Airflow DQ gate task)
# -----------------------------------------------------------------------------
# Fail the pipeline if the reject rate for a batch exceeds this fraction
DQ_MAX_REJECT_RATE=0.25
# Warn if no new file has landed within this many minutes
DQ_MAX_FILE_DELAY_MINUTES=90
